{
  "name": "trade-assistant-app",
  "version": "0.1.0",
  "private": true,
  "description": "Trade Assistant Electron shell (read-only analysis; never places orders).",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite build && electron-vite preview",
    "prestart": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm rebuild better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@modelcontextprotocol/sdk": "1.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "33.2.0",
    "electron-vite": "2.3.0",
    "jsdom": "^29.1.1",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "dompurify": "^3.4.12",
    "dotenv": "^16.6.1",
    "lightweight-charts": "^5.0.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  }
}
